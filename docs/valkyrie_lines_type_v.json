    "valkyrie.automata_valkyries.speech.rain.high.2": "The sound of rain is kind of soothing.",
    "valkyrie.automata_valkyries.speech.rain.high.3": "Cold! Master, let's get under a roof!",
    "valkyrie.automata_valkyries.speech.sleepy.low.1": "Power depleted. Entering sleep... mode...",
    "valkyrie.automata_valkyries.speech.sleepy.low.2": "...Rebooted. Recovered from dormancy.",
