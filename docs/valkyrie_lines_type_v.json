    "valkyrie.automata_valkyries.speech.gift_ice.low.1": "Cooling Ice received. Core temperature dropping.",
    "valkyrie.automata_valkyries.speech.gift_ice.low.2": "Thank you for the coolant.",
    "valkyrie.automata_valkyries.speech.gift_ice.low.3": "Heat dissipation improved. Thank you.",
    "valkyrie.automata_valkyries.speech.gift_ice.high.1": "So cold! But so tasty!",
    "valkyrie.automata_valkyries.speech.gift_ice.high.2": "Ice! Ooh, brain freeze!",
    "valkyrie.automata_valkyries.speech.gift_ice.high.3": "So chilly~ Want to share half, Master?",
    "valkyrie.automata_valkyries.speech.repaired.low.1": "Repairs confirmed. Damage rate reduced.",
    "valkyrie.automata_valkyries.speech.repaired.low.2": "Thank you for the maintenance, Master.",
    "valkyrie.automata_valkyries.speech.repaired.low.3": "Armor restored. Combat-ready.",
    "valkyrie.automata_valkyries.speech.repaired.high.1": "Thanks for fixing me! It doesn't hurt anymore.",
    "valkyrie.automata_valkyries.speech.repaired.high.2": "Your care is so gentle, Master.",
    "valkyrie.automata_valkyries.speech.repaired.high.3": "Ehehe, I'm all shiny now.",
    "valkyrie.automata_valkyries.speech.revived.low.1": "Reboot complete. Memory banks intact.",
    "valkyrie.automata_valkyries.speech.revived.low.2": "Recovered from shutdown. Orders, please.",
    "valkyrie.automata_valkyries.speech.revived.low.3": "System restored. Master re-identified.",
    "valkyrie.automata_valkyries.speech.revived.high.1": "Master... we meet again. I'm home.",
    "valkyrie.automata_valkyries.speech.revived.high.2": "You woke me up... thank you.",
    "valkyrie.automata_valkyries.speech.revived.high.3": "I was calling for you in my dreams.",
    "valkyrie.automata_valkyries.speech.owner_saved.low.1": "Master's survival confirmed. Mission accomplished.",
    "valkyrie.automata_valkyries.speech.owner_saved.low.2": "Defense successful. Damage within tolerance.",
    "valkyrie.automata_valkyries.speech.owner_saved.low.3": "Crisis averted. No threats nearby.",
    "valkyrie.automata_valkyries.speech.owner_saved.high.1": "Thank goodness... I'm so glad you're safe...",
    "valkyrie.automata_valkyries.speech.owner_saved.high.2": "I told you I'd protect you, didn't I?",
    "valkyrie.automata_valkyries.speech.owner_saved.high.3": "Don't be reckless... I was so worried.",
    "valkyrie.automata_valkyries.speech.owner_hurt.low.1": "Master has taken a hit. Providing cover.",
    "valkyrie.automata_valkyries.speech.owner_hurt.low.2": "Warning: Master's vitals dropping.",
    "valkyrie.automata_valkyries.speech.owner_hurt.low.3": "Hostile action confirmed. Moving to eliminate.",
    "valkyrie.automata_valkyries.speech.owner_hurt.high.1": "Master! Are you okay?! I'm coming!",
    "valkyrie.automata_valkyries.speech.owner_hurt.high.2": "How dare you hurt my Master... unforgivable!",
    "valkyrie.automata_valkyries.speech.owner_hurt.high.3": "Don't push it. Stay behind me!",
    "valkyrie.automata_valkyries.speech.boss_down.low.1": "Target silenced. Combat concluded.",
    "valkyrie.automata_valkyries.speech.boss_down.low.2": "Threat eliminated. Reporting damage status.",
    "valkyrie.automata_valkyries.speech.boss_down.low.3": "Large signature lost. Good work.",
    "valkyrie.automata_valkyries.speech.boss_down.high.1": "We did it, Master! We're the strongest!",
    "valkyrie.automata_valkyries.speech.boss_down.high.2": "We won...! With you, I can't lose.",
    "valkyrie.automata_valkyries.speech.boss_down.high.3": "High five! Yaaay!",
    "valkyrie.automata_valkyries.speech.night.low.1": "Sunset confirmed. Switching to night watch.",
    "valkyrie.automata_valkyries.speech.night.low.2": "Night-vision sensors active.",
    "valkyrie.automata_valkyries.speech.night.low.3": "Hostile activity rises at night. Stay alert.",
    "valkyrie.automata_valkyries.speech.night.high.1": "It's night now. Stay close, Master.",
    "valkyrie.automata_valkyries.speech.night.high.2": "The stars are pretty... watch with me?",
    "valkyrie.automata_valkyries.speech.night.high.3": "I'll keep watch tonight, so rest easy.",
    "valkyrie.automata_valkyries.speech.rain.low.1": "Rainfall detected. Waterproofing nominal.",
