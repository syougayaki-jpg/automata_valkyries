    "valkyrie.automata_valkyries.speech.sleepy.high.1": "Mmnh... Master... just a little longer...",
    "valkyrie.automata_valkyries.speech.sleepy.high.2": "Yawn... morning. Did I fall asleep?",
    "valkyrie.automata_valkyries.speech.sleepy.high.3": "So sleepy... wake me up, Master...",
    "valkyrie.automata_valkyries.speech.lonely.low.1": "Long shutdown logged. ...Continuing standby.",
    "valkyrie.automata_valkyries.speech.lonely.low.2": "Link to Master lost for an extended time.",
    "valkyrie.automata_valkyries.speech.lonely.low.3": "...No response to my calls. Standing by.",
    "valkyrie.automata_valkyries.speech.lonely.high.1": "Master... where are you? I'm lonely...",
    "valkyrie.automata_valkyries.speech.lonely.high.2": "I waited so long... don't forget me.",
    "valkyrie.automata_valkyries.speech.lonely.high.3": "It's dark and quiet... please come back soon...",
    "valkyrie.automata_valkyries.speech.sync_up.low.1": "Sync rate increased. Coordination improved.",
    "valkyrie.automata_valkyries.speech.sync_up.low.2": "Synchronization with Master updated.",
    "valkyrie.automata_valkyries.speech.sync_up.low.3": "Sync rate milestone confirmed.",
    "valkyrie.automata_valkyries.speech.sync_up.high.1": "Our bond just got deeper, Master!",
    "valkyrie.automata_valkyries.speech.sync_up.high.2": "I can feel our hearts connecting!",
    "valkyrie.automata_valkyries.speech.sync_up.high.3": "I want to know even more about you, Master."
